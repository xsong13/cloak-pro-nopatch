{
    "name": "cloak-pro-nopatch",
    "version": "1.2.3",
    "description": "Unlimited concurrent sessions for an already patched CloakBrowser Pro build, without touching the browser installation.",
    "type": "module",
    "main": "./dist/index.js",
    "types": "./dist/index.d.ts",
    "exports": {
        ".": {
            "types": "./dist/index.d.ts",
            "import": "./dist/index.js"
        }
    },
    "files": [
        "dist",
        "src",
        "README.md",
        "tsconfig.json"
    ],
    "scripts": {
        "clean": "node -e \"require('node:fs').rmSync('dist',{recursive:true,force:true})\"",
        "build": "npm run clean && tsc -p tsconfig.json",
        "typecheck": "tsc -p tsconfig.json --noEmit",
        "watch": "tsc -p tsconfig.json --watch",
        "diagnose": "node dist/diagnose.js",
        "example": "node dist/example.js",
        "test:readonly": "node dist/test_readonly.js",
        "check": "npm run typecheck && npm run build && npm run test:readonly"
    },
    "engines": {
        "node": ">=18"
    },
    "peerDependencies": {
        "cloakbrowser": ">=0.6.3"
    },
    "devDependencies": {
        "@types/node": "^26.6.5",
        "typescript": "^7.0.2"
    },
    "keywords": [
        "cloakbrowser",
        "playwright",
        "stealth",
        "license",
        "read-only"
    ],
    "license": "MIT",
    "dependencies": {
        "playwright-core": "^1.64.1"
    }
}
